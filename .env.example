# Copy to .env and fill in. Never commit .env.

# PostgreSQL. This value matches docker-compose.yml for local development.
# For Neon, paste its connection string and add &connect_timeout=30 (its database may need a few
# seconds to wake up).
DATABASE_URL="postgresql://brightlink:brightlink@localhost:5433/brightlink?schema=public"

# Public site address, used for the sitemap and robots.txt (no trailing slash).
SITE_URL="http://localhost:3000"

# ── Cloudflare R2: where photos and videos uploaded in the CMS are stored ──
# Optional, only for testing against another S3-compatible server instead of real R2:
# R2_ENDPOINT="http://localhost:9000"
# # Cloudflare dashboard → R2 → your bucket. See README "Setting up R2" for the CORS rule videos need.
# TODO: fill in once the bucket exists.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""        # R2 → Manage API tokens → create token with "Object Read & Write" on this bucket
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""               # e.g. brightlink-media
R2_PUBLIC_HOSTNAME=""      # custom domain or r2.dev subdomain, without https://, e.g. media.brightlinkltd.com

# ── Email: every new contact message is emailed to the "notification email" in the site settings ──
# Any SMTP server works. See README "Setting up email".
# Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER = the Gmail address,
#        SMTP_PASS = a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
# TODO: fill in before launch.
SMTP_HOST=""
SMTP_PORT="465"            # 465 (TLS) or 587 (STARTTLS)
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""              # e.g. "BrightLink website <info@brightlinkltd.com>" (Gmail: must be SMTP_USER)

# ── Spam protection for the contact form: Cloudflare Turnstile ──
# Cloudflare dashboard → Turnstile → Add widget (domains: brightlinkltd.com, localhost). Leave empty to skip in development.
# TODO: fill in before launch.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
